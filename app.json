{
  "expo": {
    "name": "Time & Pay Tracker",
    "slug": "time-pay-tracker",
    "version": "2.3.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "timepaytracker",
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Time & Pay Tracker to select a timesheet image for review and import.",
          "cameraPermission": "Allow Time & Pay Tracker to photograph a timesheet for review and import.",
          "microphonePermission": false
        }
      ]
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#071A33"
      },
      "package": "com.timepaytracker.mobile",
      "versionCode": 8
    }
  }
}
